{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BA output BATCH",
  "type": "object",
  "required": ["mode", "domain", "project_summary", "global_functional_requirements", "global_non_functional_requirements", "cases", "_meta"],
  "properties": {
    "mode": {"const": "batch"},
    "domain": {"type": "string", "minLength": 2},
    "project_summary": {
      "type": "object",
      "required": ["title", "total_cases", "value_metric"],
      "properties": {
        "title": {"type": "string"},
        "total_cases": {"type": "integer", "minimum": 1},
        "value_metric": {"type": "string"},
        "value_total": {"type": ["number", "null"]},
        "partitions": {"type": "array", "items": {"type": "string"}},
        "source_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "global_functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^FR-\\d+$"},
          "description": {"type": "string"},
          "priority": {"type": "string"}
        }
      }
    },
    "global_non_functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "target"],
        "properties": {
          "id": {"type": "string", "pattern": "^NFR-\\d+$"},
          "category": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    },
    "pattern_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "case_ids"],
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "case_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rank", "short", "name", "value_primary", "process_steps", "pain_points", "automation_potential"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rank": {"type": "integer"},
          "partition": {"type": ["string", "null"]},
          "src_sheet": {"type": ["string", "null"]},
          "short": {"type": "string"},
          "name": {"type": "string"},
          "pattern_group": {"type": ["string", "null"]},
          "value_primary": {"type": ["number", "null"]},
          "value_metric_meaning": {"type": ["string", "null"]},
          "frequency": {"type": ["string", "null"]},
          "host_systems": {"type": "array", "items": {"type": "string"}},
          "human_dependency": {"type": ["string", "null"]},
          "process_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "pain_points": {"type": "array", "items": {"type": "string"}},
          "automation_potential": {"type": "number", "minimum": 0, "maximum": 1},
          "automation_approach": {"type": ["string", "null"]}
        }
      }
    },
    "assumptions": {"type": "array"},
    "open_questions": {"type": "array"},
    "_meta": {"$ref": "#/$defs/meta"}
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["tokens_in", "tokens_out", "duration_s", "model"],
      "properties": {
        "tokens_in": {"type": ["integer", "null"]},
        "tokens_out": {"type": ["integer", "null"]},
        "duration_s": {"type": ["integer", "null"]},
        "model": {"type": "string"}
      }
    }
  }
}
