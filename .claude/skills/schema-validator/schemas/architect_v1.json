{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect output SINGLE",
  "type": "object",
  "required": ["mode", "precheck", "architecture_overview", "components", "mermaid_diagrams", "nfr_matrix", "risk_register", "key_design_decisions", "_meta"],
  "properties": {
    "mode": {"const": "single"},
    "precheck": {"type": "object"},
    "architecture_overview": {"type": "string", "minLength": 30},
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "responsibility", "tech"],
        "properties": {
          "name": {"type": "string"},
          "responsibility": {"type": "string"},
          "tech": {"type": "string"},
          "bounded_context": {"type": ["string", "null"]}
        }
      }
    },
    "data_flow_description": {"type": ["string", "null"]},
    "mermaid_diagrams": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["type", "title", "code"],
        "properties": {
          "type": {"type": "string"},
          "title": {"type": "string"},
          "code": {"type": "string", "minLength": 20}
        }
      }
    },
    "nfr_matrix": {"type": "array", "minItems": 1},
    "risk_register": {"type": "array", "minItems": 1},
    "key_design_decisions": {"type": "array", "minItems": 1},
    "_meta": {"$ref": "#/$defs/meta"}
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["tokens_in", "tokens_out", "duration_s", "model"],
      "properties": {
        "tokens_in": {"type": ["integer", "null"]},
        "tokens_out": {"type": ["integer", "null"]},
        "duration_s": {"type": ["integer", "null"]},
        "model": {"type": "string"}
      }
    }
  }
}
