{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect output BATCH",
  "type": "object",
  "required": ["mode", "precheck", "architecture_style", "build_priority", "capabilities", "cases", "overall", "nfr_matrix", "data_architecture", "security_compliance", "operational_view", "risk_register", "cost_breakdown", "key_design_decisions", "_meta"],
  "properties": {
    "mode": {"const": "batch"},
    "architecture_style": {
      "type": "object",
      "required": ["primary", "rationale", "key_principles"],
      "properties": {
        "primary": {"type": "string"},
        "rationale": {"type": "string", "minLength": 20},
        "key_principles": {"type": "array", "items": {"type": "string"}, "minItems": 3}
      }
    },
    "build_priority": {
      "type": "object",
      "required": ["phases", "ordered_capabilities", "critical_path", "roadmap_mmd"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "title", "deliverable"]
          }
        },
        "ordered_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "build_order", "build_phase", "dependencies", "enables"],
            "properties": {
              "id": {"type": "string"},
              "build_order": {"type": "integer", "minimum": 1},
              "build_phase": {"type": "string"},
              "dependencies": {"type": "array"},
              "enables": {"type": "array"},
              "priority_rationale": {"type": ["string", "null"]}
            }
          }
        },
        "critical_path": {"type": "array", "items": {"type": "string"}, "minItems": 2},
        "roadmap_mmd": {"type": "string", "minLength": 20}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "internal_mermaid", "use_case_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^C\\d+$"},
          "name": {"type": "string"},
          "internal_mermaid": {"type": "string", "minLength": 30},
          "use_case_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "deps": {"type": "array"},
          "enables": {"type": "array"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fmd", "mmd", "exc", "capability_ids"],
        "properties": {
          "id": {"type": "string"},
          "fmd": {
            "type": "string",
            "minLength": 5,
            "description": "Mermaid flowchart code HOẶC chuỗi 'REUSE:Pxxx' (strategy=canonical_reuse) — Writer sẽ clone từ pattern_group Pxxx + apply delta_notes."
          },
          "mmd": {
            "type": "string",
            "minLength": 5,
            "description": "Mermaid sequence code HOẶC chuỗi 'REUSE:Pxxx'."
          },
          "exc": {
            "type": "array",
            "description": "Exception table; có thể rỗng khi case dùng REUSE pattern (sẽ inherit từ pattern_group)."
          },
          "capability_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "delta_notes": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Khi fmd/mmd dùng REUSE, ghi rõ delta so với canonical pattern."
          },
          "pattern_group_id": {"type": ["string", "null"]}
        }
      }
    },
    "overall": {
      "type": "object",
      "required": ["fmd", "lifecycle_mmd", "pipeline_mmd"],
      "properties": {
        "c4_context_mmd": {"type": ["string", "null"]},
        "c4_container_mmd": {"type": ["string", "null"]},
        "fmd": {"type": "string", "minLength": 20},
        "lifecycle_mmd": {"type": "string", "minLength": 20},
        "pipeline_mmd": {"type": "string", "minLength": 20}
      }
    },
    "nfr_matrix": {"type": "array", "minItems": 1},
    "data_architecture": {"type": "object"},
    "security_compliance": {"type": "object"},
    "operational_view": {"type": "object"},
    "risk_register": {"type": "array", "minItems": 3},
    "cost_breakdown": {"type": "object"},
    "key_design_decisions": {"type": "array", "minItems": 1},
    "_meta": {"$ref": "#/$defs/meta"}
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["tokens_in", "tokens_out", "duration_s", "model"],
      "properties": {
        "tokens_in": {"type": ["integer", "null"]},
        "tokens_out": {"type": ["integer", "null"]},
        "duration_s": {"type": ["integer", "null"]},
        "model": {"type": "string"}
      }
    }
  }
}
